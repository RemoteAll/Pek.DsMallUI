@* iframe 内的工作区内容（对应参考项目后台右侧 `iframe#main-frame` 里显示的页面）。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@Model.displayName</h3>
                <h5>当前区域：@Model.areaName（路由前缀 @Model.areaRoute）</h5>
            </div>
        </div>
    </div>

    <div class="ncap-form-default">
        <dl>
            <dt>站点名称</dt>
            <dd>@Model.siteName</dd>
        </dl>
        <dl>
            <dt>上传目录</dt>
            <dd>@Model.uploadPrefix</dd>
        </dl>
        <dl>
            <dt>当前用户</dt>
            <dd>@Model.userName</dd>
        </dl>
        <dl>
            <dt>版本</dt>
            <dd>@Model.version</dd>
        </dl>
        <dl>
            <dt>快捷入口</dt>
            <dd>
                @if (Model.hasMenus) {
                <ul class="article_list">
                    @foreach (var menu in Model.menus) {
                    <li><a href="@menu.url">@menu.name</a> — @menu.desc</li>
                    }
                </ul>
                } else {
                <p class="notic">当前没有可用的后台页面。</p>
                }
            </dd>
        </dl>
    </div>
</div>
