@* 后台框架页：逐段移植参考项目 `G:\Project\B2B2CShop\src\B2B2CShop\Areas\Admin\Views\Home\DashBoard.cshtml`
   （`admincp-header` 顶栏 + `admincp-container` 左侧 `#mainMenu` + 右侧 `iframe#main-frame`，JS `openItem()` 驱动）。
   与 C# 的差异：`ViewBag`/`@Url.Action` 换成模型字段，菜单的 controller/action/module 已在 Rust 侧预计算。 *@
@{
    // C# 里是 `Layout = null`（整页自带 head）；本引擎用空串表示不用布局。
    Layout = "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@Model.displayName</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <link rel="stylesheet" href="/static/admin/css/admin.css" />
    <link rel="stylesheet" href="/static/plugins/js/jqueryui/jquery-ui.min.css">
    <script src="/static/plugins/jquery214.min.js"></script>
    <script src="/static/plugins/jquery.validate.min.js"></script>
    <script src="/static/plugins/jquery.cookie.js"></script>
    <script src="/static/plugins/common.js"></script>
    <script src="/static/admin/js/admin.js"></script>
    <script src="/static/plugins/js/jqueryui/jquery-ui.min.js"></script>
    <script src="/static/plugins/js/jqueryui/jquery.ui.datepicker-zh-CN.js"></script>
    <script src="/static/plugins/perfect-scrollbar.min.js"></script>
    <script src="/static/plugins/layer/layer.js"></script>
    <script src="/static/plugins/js/layui/layui.js"></script>
    <link rel="stylesheet" href="/static/plugins/js/layui/css/layui.css">
    <style>
        /* 首个模块的左栏默认展开，JS 的 show/hide（内联样式）会覆盖它 */
        #mainMenu > ul:first-child { display: block; }
    </style>
    <script type="text/javascript">
        var HOMESITEURL = "/";
        var ADMINSITEURL = "@Model.areaRoute";
        var ADMINSITEROOT = "/static/admin";
        var BASESITEURL = "/";
        /** 计算 hash（与 C# 同口径） */
        function generateHash(str) {
            const pwdStr = str.match(/password=([^&]+)/);
            const hash = 'password=' + CryptoJS.MD5(pwdStr[1]).toString();
            return str.replace(/password=([^&]+)/, hash.toUpperCase());
        }
        function generateHash2(str) {
            return CryptoJS.MD5(str).toString().toUpperCase();
        }
    </script>
</head>
<body>
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    <div class="admincp-header">
        <div class="logo">
            <img src="/static/admin/images/backlogo.png" />
        </div>
        <div class="navbar">
            <ul class="fl" style="float:left;">
                @foreach (var module in Model.modules) {
                <li id="nav_@module.key">
                    <a href="javascript:void(0)" onclick="openItem('@module.key')">@module.title</a>
                </li>
                }
            </ul>
            <ul class="fr" style="float:right">
                <li>
                    <span>您好,@Model.userName</span>
                    <div class="sub-meun">
                        <dl style="overflow: unset !important;">
                            <dd><a href="/" target="_blank"><i class="layui-icon">&#xe68e;</i> 访问首页</a></dd>
                            <dd><a href="@Model.configUrl" target="main-frame"><i class="layui-icon">&#xe640;</i> 站点设置</a></dd>
                            <dd><a href="@Model.logoutUrl"><i class="iconfont">&#xe70c;</i> 安全退出</a></dd>
                        </dl>
                    </div>
                </li>
                <li style="width: 50px;opacity: 0;"></li>
            </ul>
        </div>
    </div>

    <div class="admincp-container">
        <div class="admincp-container-left">
            <div id="mainMenu">
                @foreach (var module in Model.modules) {
                <ul id="sort_@module.key" style="display:none">
                    @foreach (var item in module.items) {
                    <li id="@item.leftId">
                        <a href="javascript:void(0)" onclick="openItem('@item.action,@item.controller,@item.module')">
                            <i class="layui-icon @item.icon"></i>@item.title
                        </a>
                    </li>
                    }
                </ul>
                }
            </div>
        </div>
        <div class="admincp-container-right">
            <div class="top-border"></div>
            <iframe src="@Model.mainUrl" id="main-frame" name="main-frame" style="overflow: visible; width: 100%; height:100%;" frameborder="0" scrolling="yes"></iframe>
        </div>
    </div>
    <script>
        $(function () {
            if ($.cookie('now_location_controller') != null) {
                openItem($.cookie('now_location_action') + ',' + $.cookie('now_location_controller') + ',' + $.cookie('now_location_module'));
            } else {
                $('#mainMenu>ul').first().css('display', 'block');
                $('#mainMenu>ul').first().children('li').first().addClass('selected');
            }
        });

        function openItem(args) {
            var spl = args.split(',');
            var action = spl[0];
            var controller, module;
            try {
                controller = spl[1];
                module = spl[2];
            } catch (ex) {
            }
            if (typeof (controller) == 'undefined') {
                module = args;
            }
            // 顶部导航样式处理
            $('.actived').removeClass('actived');
            $('#nav_' + module).addClass('actived');
            // 清除左侧样式
            $('.selected').removeClass('selected');

            // 切换左栏分组
            $('#mainMenu ul').css('display', 'none');
            $('#sort_' + module).css('display', 'block');

            if (typeof (controller) == 'undefined') {
                // 顶部菜单事件：打开该模块第一项
                var first = $('#sort_' + module + '>li').first();
                var html = first.html();
                var str = html.match(/openItem\('(.*)'\)/ig);
                var arg = str[0].split("'");
                spl = arg[1].split(',');
                action = spl[0];
                controller = spl[1];
                module = spl[2];
                first.addClass('selected');
            } else {
                // 左侧菜单事件：记住位置
                $.cookie('now_location_module', module);
                $.cookie('now_location_controller', controller);
                $.cookie('now_location_action', action);
                $('#left_' + module + controller + action).addClass('selected');
            }

            // 本站路由形如 /admin/{controller}/{action}，action 恒非空
            $('#main-frame').attr('src', ADMINSITEURL + '/' + controller + '/' + action);
        }
    </script>
</body>
</html>
